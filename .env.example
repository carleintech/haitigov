# Runtime tier. Allowed: development, test, staging, production.
HAITIGOV_ENVIRONMENT=development

# Node execution mode. Staging and production use production.
NODE_ENV=development

# Structured log threshold. Allowed: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# Local PostgreSQL/PostGIS development database. Never reuse these values in
# staging or production. Set a unique password in the ignored root .env file.
HAITIGOV_DB_NAME=haitigov_dev
HAITIGOV_DB_USER=haitigov
HAITIGOV_DB_PASSWORD=replace-with-a-local-development-password
HAITIGOV_DB_PORT=55433
DATABASE_URL=postgresql://haitigov:replace-with-a-local-development-password@localhost:55433/haitigov_dev?schema=public

# Public API version root used by the server-rendered web catalogue. HTTPS is
# required outside loopback development. Omit it to show a safe unconfigured state.
HAITIGOV_PUBLIC_API_URL=http://127.0.0.1:3001/v1
