{
  "name": "haitigov",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Proposed Haiti digital public-service and interoperability platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.1",
    "pnpm": ">=12.6.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm run db:generate && pnpm run config:check && pnpm run env:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run secrets:scan",
    "check:container": "pnpm run config:check && pnpm run env:check && pnpm run format:check && pnpm run lint:container && pnpm run typecheck:container && pnpm run test:unit && pnpm --filter @haitigov/api run test && pnpm run secrets:scan",
    "clean": "turbo run clean",
    "commitlint": "commitlint",
    "config:check": "node scripts/validate-config.mjs",
    "db:generate": "pnpm --filter @haitigov/database run db:generate",
    "dev": "turbo run dev",
    "env:check": "node scripts/validate-environment.mjs --file .env.example",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && eslint . --max-warnings=0 && turbo run lint",
    "lint:container": "biome lint . && eslint . --max-warnings=0 && turbo run lint --cache=local:r --cache-dir=/tmp/turbo --output-logs=none",
    "prepare": "husky",
    "secrets:scan": "secretlint \"**/*.{cjs,css,env,example,html,js,json,jsonc,jsx,md,mjs,ts,tsx,txt,yaml,yml}\"",
    "storybook": "pnpm --filter @haitigov/storybook run dev",
    "service:review-queue": "node scripts/service-review-queue.mjs",
    "test": "pnpm run test:unit && turbo run test",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/platform tests/tooling",
    "test:visual": "pnpm --filter @haitigov/storybook run test:visual",
    "typecheck": "tsc --project tsconfig.json --noEmit && turbo run typecheck",
    "typecheck:container": "tsc --project tsconfig.json --noEmit && turbo run typecheck --cache=local:r --cache-dir=/tmp/turbo --output-logs=none"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@types/node": "24.13.6",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "secretlint": "13.0.6",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
