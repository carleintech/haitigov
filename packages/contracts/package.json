    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@haitigov/typescript-config": "workspace:*"
  }
