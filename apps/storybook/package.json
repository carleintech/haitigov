{
  "name": "@haitigov/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "storybook build --quiet",
    "clean": "node -e \"require('node:fs').rmSync('storybook-static',{recursive:true,force:true})\"",
    "dev": "storybook dev --port 6006 --no-open",
    "lint": "eslint .storybook scripts src tests playwright.config.ts --max-warnings=0",
    "test": "vitest run src --passWithNoTests",
    "test:visual": "pnpm --workspace-root exec turbo run build --filter=@haitigov/storybook... && playwright test",
    "test:visual:update": "pnpm --workspace-root exec turbo run build --filter=@haitigov/storybook... && playwright test --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@haitigov/branding": "workspace:*",
    "@haitigov/design-system": "workspace:*",
    "@haitigov/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@haitigov/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "storybook": "10.6.0",
    "vite": "8.3.1"
  }
}
